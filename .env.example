# TMDB API 키 (https://www.themoviedb.org/settings/api 에서 발급)
# server/api/discover.ts에서 서버 전용으로만 사용된다. 클라이언트에 노출되지 않음.
TMDB_API_KEY=

# Gemini API 키 (https://aistudio.google.com/apikey 에서 발급)
# server/api/review-insight.ts에서 서버 전용으로만 사용된다. 클라이언트에 노출되지 않음.
GEMINI_API_KEY=

# Supabase 프로젝트 (https://supabase.com/dashboard → Project Settings → API)
# 보관함(찜하기·별점) 로그인/DB용. anon key 는 RLS 로 보호되는 게 전제라
# 클라이언트에 노출되는 게 정상이다(TMDB/Gemini 키와 성격이 다름).
# SQL 스키마는 supabase/schema.sql — Supabase SQL Editor에 그대로 붙여넣으면 된다.
# 매직링크가 동작하려면 대시보드 Authentication → URL Configuration →
# Redirect URLs 에 http://localhost:3000/** (배포 도메인도) 를 등록해야 한다.
SUPABASE_URL=
SUPABASE_ANON_KEY=
